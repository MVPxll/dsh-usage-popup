{
  "name": "dsh-usage-popup",
  "version": "2.3.1",
  "description": "消耗弹窗 · 每轮对话弹出高峰/低谷期提醒，回复结束时显示本轮花费、平均缓存命中率与今日累计，并在输入框状态栏给出实时高峰/低谷徽标。玻璃拟态外观，内置 DeepSeek flash/Pro 计价，也可自定义。Glassmorphism usage popup for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "usage",
    "cost",
    "billing",
    "pricing",
    "cache",
    "peak",
    "off-peak",
    "cny"
  ],
  "license": "MIT",
  "author": "MVP小刘刘",
  "homepage": "https://github.com/MVPxll/dsh-usage-popup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MVPxll/dsh-usage-popup.git"
  },
  "bugs": {
    "url": "https://github.com/MVPxll/dsh-usage-popup/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale"
      ]
    }
  }
}
